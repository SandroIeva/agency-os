{
  "display_information": {
    "name": "i7OS",
    "description": "Notifications from your i7OS workspace, with buttons that move a task without opening the app.",
    "background_color": "#15151c"
  },
  "features": {
    "bot_user": {
      "display_name": "i7OS",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/i7os",
        "url": "https://app.i7os.com/api/slack",
        "description": "Create a task in i7OS",
        "usage_hint": "what needs doing",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://app.i7os.com/slack/callback"
    ],
    "scopes": {
      "bot": [
        "chat:write",
        "im:write",
        "commands"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://app.i7os.com/api/slack"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
